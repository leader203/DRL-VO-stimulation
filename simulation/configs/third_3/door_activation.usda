over "World"
{
    over "AutomaticDoors"
    {
        # The inward swing leaves separate entry and interior exit approach regions.
        custom bool automaticDoor:requireFrontApproach = true
        custom double automaticDoor:approachDistance = 0.55
        custom double automaticDoor:exitApproachDistance = 0.72
        custom double automaticDoor:facingHalfAngle = 30
    }
}
